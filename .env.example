# X-ONE · AI BRAIN — Configuração
# Copia este ficheiro para .env e ajusta os valores.

# ── Ollama (motor dos modelos locais) ──
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# ── Servidor ──
PORT=7777

# ── Chat ──
MAX_HISTORY=20      # nº de mensagens de contexto enviadas ao modelo
MAX_TOKENS=2048     # tamanho máximo de cada resposta

# ── Voz (opcional) ──
TTS_ENABLED=0       # 1 = ativa TTS na resposta (requer ffmpeg + sox)

# ── Nuvem (opcional) ──
# Se definida, o X-ONE usa o Claude na nuvem em vez dos modelos locais.
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-4-6

# ── Integrações (opcional) ──
# MONRUST3_TOKEN=   # token de sessão do MonRust3, se usares essa integração
