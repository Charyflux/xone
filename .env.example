# X-ONE v4.0 Configuration

# ═════════════════════════════════════════════════════════════
# OLLAMA CONFIGURATION
# ═════════════════════════════════════════════════════════════

# Ollama server URL
OLLAMA_URL=http://localhost:11434

# Default model to use
# Options: dolphin-llama3, llama3.2, llama3.2:1b, qwen2.5-coder:7b, etc
OLLAMA_MODEL=dolphin-llama3

# ═════════════════════════════════════════════════════════════
# SERVER CONFIGURATION
# ═════════════════════════════════════════════════════════════

# Server port (default: 7777)
PORT=7777

# ═════════════════════════════════════════════════════════════
# CHAT CONFIGURATION
# ═════════════════════════════════════════════════════════════

# Number of previous messages to keep in context
MAX_HISTORY=20

# Maximum tokens per response
MAX_TOKENS=512

# ═════════════════════════════════════════════════════════════
# ADVANCED OPTIONS
# ═════════════════════════════════════════════════════════════

# GPU layers (0=CPU, 1+=GPU)
OLLAMA_NUM_GPU=1

# CPU threads
OLLAMA_NUM_THREAD=8

# Performance Presets (uncomment one):
# Fast Mode: MAX_HISTORY=10 MAX_TOKENS=300 OLLAMA_MODEL=llama3.2:1b
# Balanced: MAX_HISTORY=20 MAX_TOKENS=512 OLLAMA_MODEL=llama3.2 (default)
# Quality: MAX_HISTORY=30 MAX_TOKENS=1024 OLLAMA_MODEL=dolphin-llama3
