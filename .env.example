# ═══════════════════════════════════════════════════════════
#  X-ONE — Configuração
#  Copie este arquivo para ".env" e ajuste se quiser.
# ═══════════════════════════════════════════════════════════

# 🧠 Modelo de IA (Ollama). O padrão é ABLITERATED = SEM FILTRO.
#   • huihui_ai/qwen2.5-abliterate:3b  → rápido, roda em CPU modesta (recomendado)
#   • huihui_ai/qwen2.5-abliterate:7b  → melhor qualidade, precisa de mais CPU/GPU
OLLAMA_MODEL=huihui_ai/qwen2.5-abliterate:3b

# 🔌 Endereço do Ollama (deixe assim se rodar na mesma máquina)
OLLAMA_URL=http://localhost:11434

# 🌐 Porta onde o X-ONE abre (acesse http://localhost:7777)
PORT=7777

# ✍️ Máximo de tokens por resposta. Menor = respostas mais curtas e RÁPIDAS.
MAX_TOKENS=600

# 🔊 Voz (Text-to-Speech). 1 para ligar, 0 para desligar.
TTS_ENABLED=0

# ⚠️ (OPCIONAL) Chave da Anthropic (Claude). Se preencher, o X-ONE usa o Claude
#    — que TEM FILTRO e recusa conteúdo ofensivo. Para o modo 100% SEM FILTRO,
#    deixe esta linha VAZIA (o padrão usa o modelo local abliterated).
ANTHROPIC_API_KEY=
